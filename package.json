{
  "name": "mtg-manager-api",
  "version": "1.0.0",
  "description": "MTG Deck & Card Management API built with Clean Architecture, TypeScript, and Fastify",
  "main": "dist/main/server.js",
  "scripts": {
    "dev": "tsx watch -r tsconfig-paths/register src/main/server.ts",
    "build": "tsc",
    "start": "node -r tsconfig-paths/register dist/main/server.js",
    "lint": "eslint \"src/**/*.ts\"",
    "lint:fix": "eslint \"src/**/*.ts\" --fix",
    "format": "prettier --write \"src/**/*.ts\"",
    "format:check": "prettier --check \"src/**/*.ts\""
  },
  "keywords": [
    "magic-the-gathering",
    "mtg",
    "clean-architecture",
    "fastify",
    "typescript",
    "rest-api"
  ],
  "author": "Bernardo Lannes <bernardolannes2003@gmail.com>",
  "license": "MIT",
  "dependencies": {
    "@fastify/cors": "^11.3.1",
    "@fastify/static": "^10.1.6",
    "@fastify/swagger": "^9.9.2",
    "@fastify/swagger-ui": "^6.1.2",
    "@prisma/client": "^6.19.3",
    "fastify": "^5.12.7",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/node": "^26.6.5",
    "@typescript-eslint/eslint-plugin": "^7.18.0",
    "@typescript-eslint/parser": "^7.18.0",
    "eslint": "^8.57.1",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-prettier": "^5.5.7",
    "prettier": "^3.9.10",
    "prisma": "^6.19.3",
    "tsconfig-paths": "^4.2.0",
    "tsx": "^4.23.15",
    "typescript": "~5.7.3"
  }
}
